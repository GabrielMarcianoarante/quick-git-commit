{
  "name": "quick-git-commit",
  "displayName": "Quick Git Commit",
  "description": "%ext.description%",
  "version": "0.4.4",
  "publisher": "GabrielMarcianoarante",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickGitCommit",
          "title": "Quick Git",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "quickGitCommit": [
        {
          "type": "webview",
          "id": "quickGitCommit.panel",
          "name": "%view.panel%"
        }
      ]
    },
    "commands": [
      {
        "command": "quickGitCommit.run",
        "title": "%cmd.run%",
        "icon": "$(git-commit)"
      },
      {
        "command": "quickGitCommit.openPanel",
        "title": "%cmd.openPanel%"
      },
      {
        "command": "quickGitCommit.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "quickGitCommit.guide",
        "title": "%cmd.guide%"
      },
      {
        "command": "quickGitCommit.fetch",
        "title": "%cmd.fetch%"
      },
      {
        "command": "quickGitCommit.pull",
        "title": "%cmd.pull%"
      },
      {
        "command": "quickGitCommit.push",
        "title": "%cmd.push%"
      },
      {
        "command": "quickGitCommit.stageFile",
        "title": "%cmd.stageFile%"
      },
      {
        "command": "quickGitCommit.checkUpdates",
        "title": "%cmd.checkUpdates%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "quickGitCommit.stageFile",
          "group": "quickGit@1"
        },
        {
          "command": "quickGitCommit.run",
          "group": "quickGit@2"
        }
      ],
      "editor/context": [
        {
          "command": "quickGitCommit.stageFile",
          "when": "resourceScheme == file",
          "group": "quickGit@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "quickGitCommit.stageFile",
          "when": "resourceScheme == file",
          "group": "quickGit@1"
        }
      ],
      "scm/title": [
        {
          "command": "quickGitCommit.run",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "quickGitCommit.run",
          "when": "view == quickGitCommit.panel",
          "group": "navigation@1"
        },
        {
          "command": "quickGitCommit.refresh",
          "when": "view == quickGitCommit.panel",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "quickGitCommit.stageFile",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "quickGitCommit.openPanel",
        "key": "ctrl+alt+g g",
        "mac": "cmd+alt+g g"
      },
      {
        "command": "quickGitCommit.run",
        "key": "ctrl+alt+g c",
        "mac": "cmd+alt+g c"
      },
      {
        "command": "quickGitCommit.fetch",
        "key": "ctrl+alt+g f",
        "mac": "cmd+alt+g f"
      },
      {
        "command": "quickGitCommit.pull",
        "key": "ctrl+alt+g l",
        "mac": "cmd+alt+g l"
      },
      {
        "command": "quickGitCommit.push",
        "key": "ctrl+alt+g p",
        "mac": "cmd+alt+g p"
      },
      {
        "command": "quickGitCommit.stageFile",
        "key": "ctrl+alt+g s",
        "mac": "cmd+alt+g s",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%cfg.title%",
      "properties": {
        "quickGitCommit.language": {
          "type": "string",
          "enum": [
            "auto",
            "pt-BR",
            "en"
          ],
          "default": "auto",
          "description": "%cfg.language%"
        },
        "quickGitCommit.commitTypes": {
          "type": "array",
          "default": [
            "feat",
            "fix",
            "docs",
            "style",
            "refactor",
            "chore"
          ],
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][\\w.-]*$"
              },
              {
                "type": "object",
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][\\w.-]*$"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "description": "%cfg.commitTypes%"
        },
        "quickGitCommit.messageMaxLength": {
          "type": "integer",
          "default": 72,
          "minimum": 0,
          "description": "%cfg.messageMaxLength%"
        },
        "quickGitCommit.askBranch": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.askBranch%"
        },
        "quickGitCommit.defaultAction": {
          "type": "string",
          "enum": [
            "ask",
            "commit",
            "commitAndPush"
          ],
          "enumDescriptions": [
            "%cfg.defaultAction.ask%",
            "%cfg.defaultAction.commit%",
            "%cfg.defaultAction.commitAndPush%"
          ],
          "default": "ask",
          "description": "%cfg.defaultAction%"
        },
        "quickGitCommit.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.checkForUpdates%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --baseImagesUrl https://raw.githubusercontent.com/GabrielMarcianoarante/quick-git-commit/main/",
    "publish": "vsce publish --baseImagesUrl https://raw.githubusercontent.com/GabrielMarcianoarante/quick-git-commit/main/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  },
  "icon": "resources/icon.png",
  "keywords": [
    "git",
    "commit",
    "conventional commits",
    "rebase",
    "merge",
    "scm",
    "status bar",
    "sidebar"
  ],
  "galleryBanner": {
    "color": "#0f1a30",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GabrielMarcianoarante/quick-git-commit.git"
  },
  "bugs": {
    "url": "https://github.com/GabrielMarcianoarante/quick-git-commit/issues"
  },
  "homepage": "https://github.com/GabrielMarcianoarante/quick-git-commit#readme",
  "pricing": "Free"
}
